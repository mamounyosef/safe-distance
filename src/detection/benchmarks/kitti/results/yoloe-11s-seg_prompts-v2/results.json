        "ignored_neighbours": []
      }
    },
    "class_conversion": "car and van -> Car; person -> Pedestrian; bicycle merged with its rider (person box >= 30% inside the bicycle box) -> Cyclist; rider-less bicycles dropped (parked bikes are unlabelled in KITTI)",
